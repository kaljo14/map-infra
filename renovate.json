{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "kubernetes",
    "kustomize",
    "flux",
    "github-actions",
    "pip_requirements"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.*\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^clusters/.*\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "**/secret-placeholder.yaml"
  ],
  "automerge": false,
  "dependencyDashboard": true,
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Track stable semantic application releases with immutable digests",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "kaljo14/my-map",
        "kaljo14/docs",
        "kaljo14/places-scraper"
      ],
      "versioning": "semver",
      "allowedVersions": "/^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$/",
      "pinDigests": true,
      "groupName": null,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Keep legacy latest references working until each first release is adopted",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "kaljo14/my-map",
        "kaljo14/docs",
        "kaljo14/places-scraper"
      ],
      "matchCurrentValue": "latest",
      "versioning": "docker",
      "allowedVersions": "/^latest$/",
      "pinDigests": true
    },
    {
      "description": "Tile generator producer is outside this workspace and still publishes latest",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "kaljo14/grid-tile-generator"
      ],
      "allowedVersions": "/^latest$/",
      "pinDigests": true,
      "groupName": null,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Update all Envoy sidecars together",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "envoyproxy/envoy"
      ],
      "groupName": "Envoy sidecars"
    },
    {
      "description": "Review major third-party upgrades separately",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
