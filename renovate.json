{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "kubernetes",
    "kustomize",
    "flux",
    "github-actions",
    "pip_requirements",
    "dockerfile"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.*\\.ya?ml$/",
      "/^infrastructure/.*\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^clusters/.*\\.ya?ml$/",
      "/^infrastructure/.*\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "**/secret-placeholder.yaml",
    "apps/tileserver/generator/job.yaml"
  ],
  "automerge": false,
  "dependencyDashboard": true,
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Track stable semantic application releases with immutable digests",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "kaljo14/my-map",
        "kaljo14/docs",
        "kaljo14/places-scraper"
      ],
      "versioning": "semver",
      "allowedVersions": "/^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$/",
      "pinDigests": true,
      "groupName": null,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Keep legacy latest references working until each first release is adopted",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "kaljo14/my-map",
        "kaljo14/docs",
        "kaljo14/places-scraper"
      ],
      "matchCurrentValue": "latest",
      "versioning": "docker",
      "allowedVersions": "/^latest$/",
      "pinDigests": true
    },
    {
      "description": "Update all Envoy sidecars together",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "envoyproxy/envoy"
      ],
      "groupName": "Envoy sidecars"
    },
    {
      "description": "Review major third-party upgrades separately",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Database chart and server image changes require the PostgreSQL upgrade runbook; latest digest changes can cross major versions",
      "matchFileNames": [
        "infrastructure/database/postgres/**"
      ],
      "enabled": false
    },
    {
      "description": "Backup and recovery clients must remain on the production PostgreSQL major",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Backup binaries are published using reviewed immutable commit tags",
      "matchPackageNames": [
        "ghcr.io/kaljo14/map-infra-postgres-backup",
        "ghcr.io/kaljo14/map-infra-postgres-restore"
      ],
      "enabled": false
    },
    {
      "description": "Production database base and extension versions change only through a rehearsed upgrade",
      "matchFileNames": [
        "postgres/**"
      ],
      "enabled": false
    }
  ]
}
